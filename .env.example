# The system mailbox: the Gmail you authorized with `python check_gmail.py`.
# It sends every email of the demo.
MAIL_ADDRESS=yourname@gmail.com

# Where the Yes / No buttons point. The manager's browser must be able to reach it.
#   http://localhost:8000  -> only works on THIS computer
#   https://xxxx.trycloudflare.com or https://xxxx.run.app -> works from any device
BASE_URL=http://localhost:8000

# From Google Cloud. credentials.json is downloaded; token.json is created by check_gmail.py.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
