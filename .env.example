# The SYSTEM mailbox that sends every email (a TDTU or Gmail account).
# It must be the account you authorized with `python check_gmail.py`.
MAIL_ADDRESS=your.account@student.tdtu.edu.vn

# Where the email buttons and the login point.
#   http://localhost:8000                -> this computer only
#   run_with_tunnel.py sets a public https://....trycloudflare.com address for you
BASE_URL=http://localhost:8000

# From Google Cloud: the Desktop client (for sending). token.json is created by check_gmail.py.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Sign in with Google: the Web application client, and which email domains may sign in.
LOGIN_CLIENT_FILE=login_client.json
ALLOWED_DOMAINS=tdtu.edu.vn,student.tdtu.edu.vn

# Any long random text; it signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
