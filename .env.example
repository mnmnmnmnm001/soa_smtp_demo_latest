# Where the email buttons and the sign-in come back to. Must match the port you
# run on, and <BASE_URL>/auth/callback must be a redirect URI in Google Cloud.
BASE_URL=http://localhost:8000

# --- Sign in with Google (TDTU accounts only) ---
# The "Web application" OAuth client JSON downloaded from Google Cloud.
LOGIN_CLIENT_FILE=login_client.json
ALLOWED_DOMAINS=tdtu.edu.vn,student.tdtu.edu.vn

# Any long random text; it signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
